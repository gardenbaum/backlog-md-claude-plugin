{
  "name": "backlog-md",
  "description": "Backlog.md integration: injects the active task at session start and across compaction, observes session activity, flushes edited files to the task on session end, and redirects hand-edits of Backlog.md files to the CLI that owns them.",
  "version": "0.3.10",
  "license": "MIT",
  "keywords": ["backlog", "task-management", "agent-workflow"],
  "author": { "name": "Fabian Baumgartner" },
  "repository": "https://github.com/gardenbaum/backlog-md-claude-plugin",
  "homepage": "https://github.com/gardenbaum/backlog-md-claude-plugin",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\""
          }
        ]
      }
    ]
  }
}
