#!/bin/sh
# backlog-md-plugin-hook v1
#
# Appends a `Task: <id>` trailer when Backlog.md can resolve an active task.
# Never fails a commit: every branch below exits 0.
PLUGIN_ROOT_HINT='@@PLUGIN_ROOT@@'
MSG_FILE="$1"
SOURCE="$2"

[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# A merge or squash message is git's to compose, not ours.
case "$SOURCE" in
  merge|squash) exit 0 ;;
esac

# Idempotent: an existing trailer wins, whoever wrote it.
grep -qiE '^Task:[[:space:]]*[A-Za-z]+-[0-9]' "$MSG_FILE" && exit 0

# Picks the newest of the cached install paths fed to it on stdin, comparing
# the version directory names segment by segment as numbers. Missing segments
# count as zero; a non-numeric segment outranks a number.
NEWEST_AWK='
function newer(a, b,   n, m, i, x, y, an, bn) {
  n = split(a, x, "."); m = split(b, y, ".")
  if (m > n) n = m
  for (i = 1; i <= n; i++) {
    if (x[i] == "") x[i] = "0"
    if (y[i] == "") y[i] = "0"
    if (x[i] == y[i]) continue
    an = (x[i] ~ /^[0-9]+$/); bn = (y[i] ~ /^[0-9]+$/)
    if (an && bn) return x[i] + 0 > y[i] + 0
    if (!an && !bn) return x[i] > y[i]
    return !an
  }
  return 0
}
{ version = $0; sub(/.*\//, "", version)
  if (best == "" || newer(version, best)) { best = version; path = $0 } }
END { if (path != "") print path }
'

# Resolved at run time, so a plugin update that moves the install directory
# does not retire this hook (BCC-14). Same order as lib/plugin-root.mjs and
# git/pre-commit; keep the three in step.
find_plugin_root() {
  for candidate in "$(git config --get backlog-md.pluginroot 2>/dev/null)" "$PLUGIN_ROOT_HINT" "$CLAUDE_PLUGIN_ROOT"; do
    # An unsubstituted placeholder needs no guard — see git/pre-commit.
    [ -n "$candidate" ] || continue
    if [ -f "$candidate/scripts/backlog-cc.mjs" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  # Newest wins, compared as numbers rather than strings — see git/pre-commit
  # for why, and lib/plugin-root.mjs for the reference implementation.
  newest=$(
    for candidate in "$HOME"/.claude/plugins/cache/*/backlog-md/*; do
      [ -f "$candidate/scripts/backlog-cc.mjs" ] && printf '%s\n' "$candidate"
    done | awk "$NEWEST_AWK"
  )
  [ -n "$newest" ] || return 1
  printf '%s' "$newest"
}

PLUGIN_ROOT=$(find_plugin_root) || exit 0
command -v node >/dev/null 2>&1 || exit 0

ID=$(node "$PLUGIN_ROOT/scripts/backlog-cc.mjs" active-id 2>/dev/null)
[ -n "$ID" ] || exit 0

# commit.verbose/-v/cleanup=scissors put everything from git's scissors line
# onward into the part git discards when the message is read back, so a trailer
# appended after it silently vanished. Insert immediately before that line when
# one is present; any failure falls back to the plain append so a commit is
# never blocked by this hook.
SCISSORS='# ------------------------ >8 ------------------------'
if grep -qF "$SCISSORS" "$MSG_FILE" 2>/dev/null; then
  TMP="$MSG_FILE.backlog-md.tmp.$$"
  if awk -v scissors="$SCISSORS" -v id="$ID" '
      !done && index($0, scissors) == 1 { print "Task: " id; print ""; done=1 }
      { print }
    ' "$MSG_FILE" > "$TMP" 2>/dev/null && [ -s "$TMP" ]; then
    mv "$TMP" "$MSG_FILE"
  else
    rm -f "$TMP"
    printf '\nTask: %s\n' "$ID" >> "$MSG_FILE"
  fi
else
  printf '\nTask: %s\n' "$ID" >> "$MSG_FILE"
fi
exit 0
