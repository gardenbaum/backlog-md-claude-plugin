    }
    const r = await resolveActiveTask(opts(p.root));
    assert.equal(r.state, "ambiguous");
    assert.equal(r.candidates.length, 2);
    assert.equal(r.task, undefined, "an ambiguous result must not carry a task");
  } finally {
    p.cleanup();
  }
});

